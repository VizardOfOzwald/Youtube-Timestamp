{
  "manifest_version": 3,
  "name": "YouTube Timestamp Tools — Loop & Skip",
  "version": "1.1.0",
  "description": "Loop or skip any part of a YouTube video or Short. Everything is saved per video, with one-click Undo, timeline markers, stats and backup.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YouTube Timestamp Tools",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
